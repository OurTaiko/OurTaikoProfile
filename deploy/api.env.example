# /etc/ourtaiko-profile/api.env (root-only). Values here are placeholders.
# The shared PostgreSQL (container ourtaiko-postgres on the network ourtaiko-shared).
DATABASE_URL=postgres://ourtaiko_profile:CHANGE_ME@ourtaiko-postgres:5432/ourtaiko_profile?sslmode=disable
APP_ORIGIN=https://profile.ourtaiko.org
COOKIE_SECURE=true
# The 1Panel reverse proxy must overwrite X-Real-IP; requests reach the container from the
# gateway of ourtaiko-shared, as Fanmade's do.
TRUSTED_PROXY_CIDRS=172.20.0.1/32
SSO_ISSUER=https://sso.ourtaiko.org
SSO_AVATAR_BASE_URL=https://distrib.ourtaiko.org/sso/avatars
# The Application OurTaikoProfile: website login (callback below) and user lookup.
SSO_CLIENT_ID=OurTaikoProfile
SSO_CLIENT_SECRET=CHANGE_ME
SSO_SERVICE_ID=OurTaikoProfile
SSO_SERVICE_KEY=CHANGE_ME
SSO_REDIRECT_URL=https://profile.ourtaiko.org/api/v1/auth/sso/callback
# openssl rand -hex 32
SESSION_ENCRYPTION_KEY=CHANGE_ME
# Optional: where scores are read; the default is fanmade.ourtaiko.org and database.ourtaiko.org.
# SCORE_SOURCES=[{"id":"fanmade","name":"OurTaiko Fanmade","api":"https://fanmade.ourtaiko.org","site":"https://fanmade.ourtaiko.org"},{"id":"database","name":"OurTaiko Database","api":"https://database.ourtaiko.org","site":"https://database.ourtaiko.org"}]
